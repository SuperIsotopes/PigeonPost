# Copy to .env for local testing with `vercel dev`.
# In production, set these in the Vercel dashboard instead (Settings > Environment Variables) --
# .env is not uploaded and won't be read on Vercel's servers.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="Pigeon Post <post@yourdomain.com>"
