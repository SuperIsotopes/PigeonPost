# Copy this file to .env and fill in your own values. Never commit .env.

# --- Any SMTP provider works. Pick one and fill in its details. ---

# Example: Resend (https://resend.com) -- free tier, easiest to set up
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your_resend_api_key

# Example: Gmail (needs a 16-character "app password", not your normal password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_16_char_app_password

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# The address your pigeons fly from. For Resend/SendGrid/etc this must be
# a verified sender or domain. For Gmail, use the Gmail address above.
FROM_EMAIL="Pigeon Post <post@yourdomain.com>"

PORT=3000
